{
  "name": "contractors-guild",
  "version": "0.1.0",
  "private": true,
  "description": "Contractors Guild - contractor business management, quoting and invoicing platform",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "node scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "db:status": "node scripts/db.mjs status",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:setup": "node scripts/db.mjs setup",
    "db:seed": "node scripts/seeds.mjs",
    "db:reset": "node scripts/db.mjs reset",
    "launch": "node scripts/launch.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "serve": "node scripts/serve.mjs run",
    "server:stop": "node scripts/serve.mjs stop",
    "boot:install": "node scripts/boot.mjs install",
    "boot:remove": "node scripts/boot.mjs remove",
    "boot:start": "node scripts/boot.mjs start",
    "boot:stop": "node scripts/boot.mjs stop",
    "boot:status": "node scripts/boot.mjs status"
  },
  "dependencies": {
    "next": "15.5.26",
    "pdf-lib": "^1.17.1",
    "pg": "8.23.0",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "zod": "3.25.76"
  },
  "optionalDependencies": {
    "@embedded-postgres/windows-x64": "^18.4.0-beta.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cloudflared": "^0.7.3",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.26",
    "qrcode": "^1.5.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
