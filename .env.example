# =============================================================================
# Environment template for Contractors Guild.
#
# Copy to `.env` (local development, git ignored) and fill in real values.
# NEVER commit .env. NEVER hard-code credentials, banking details or API keys
# in source code: banking details are entered per business inside the app and
# stored in the database, not in this file.
# =============================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# Public base URL used to build customer-facing links (quotes, invoices).
PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ---------------------------------------------------------------------------
# Public marketing site contact details
# ---------------------------------------------------------------------------
# Shown on the public pages (home, services, contact, request a quote).
# Replace these placeholders with the real business details before launch.
PUBLIC_CONTACT_PHONE=+27 00 000 0000
PUBLIC_CONTACT_WHATSAPP=+27000000000
PUBLIC_CONTACT_EMAIL=hello@example.com
PUBLIC_CONTACT_ADDRESS=Unit 1, Industrial Park, Your City
PUBLIC_CONTACT_HOURS=Weekends and after hours by appointment

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# The application connects with a NON-superuser role so that row level
# security (RLS) is enforced by PostgreSQL, not just by application code.
DATABASE_URL=postgresql://cg_app:local-dev-app-password@127.0.0.1:5433/contractors_guild
# Set to "require" for managed providers that mandate TLS (e.g. Supabase).
DATABASE_SSL=disable
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=15000

# Owner/migration connection. Used ONLY by scripts/db.mjs (migrations, role
# setup, test fixtures). The application never uses this URL.
DATABASE_ADMIN_URL=postgresql://cg_admin:local-dev-admin-password@127.0.0.1:5433/contractors_guild

# ---------------------------------------------------------------------------
# Local embedded PostgreSQL (development / test convenience only)
# ---------------------------------------------------------------------------
# `npm run db:start` uses these to create a disposable local cluster.
# In production you point DATABASE_URL at Supabase or any managed Postgres and
# ignore this whole block.
DEV_DB_PORT=5433
DEV_DB_DATA_DIR=data/pg
DEV_DB_SUPERUSER=cg_admin
DEV_DB_SUPERUSER_PASSWORD=local-dev-admin-password
DEV_DB_NAME=contractors_guild
APP_DB_USER=cg_app
APP_DB_PASSWORD=local-dev-app-password
# Database used by the automated test suite.
TEST_DB_NAME=contractors_guild_test

# ---------------------------------------------------------------------------
# Authentication / sessions
# ---------------------------------------------------------------------------
SESSION_COOKIE_NAME=cg_session
SESSION_TTL_DAYS=30
# scrypt work factor (must be a power of two). 16384 is a good local default;
# raise to 32768 on production hardware.
PASSWORD_HASH_COST=16384
PASSWORD_RESET_TTL_MINUTES=60

# ---------------------------------------------------------------------------
# Local file storage (business logos)
# ---------------------------------------------------------------------------
# Local disk driver for development. Production should use object storage
# (Supabase Storage / S3) through the same storage interface.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=data/uploads
MAX_UPLOAD_BYTES=2097152

# ---------------------------------------------------------------------------
# Development seed data (npm run db:seed)
# ---------------------------------------------------------------------------
# Obviously fake demo contractor created for local development only. The seed
# script refuses to run against a non-local database unless --force is passed.
SEED_DEMO_EMAIL=demo@contractorsguild.dev
SEED_DEMO_PASSWORD=guild-demo-password

# ---------------------------------------------------------------------------
# Not implemented yet - placeholders for later phases (see ROADMAP.md)
# ---------------------------------------------------------------------------
# WHATSAPP_BUSINESS_PHONE_ID=
# WHATSAPP_BUSINESS_TOKEN=
# EMAIL_DELIVERY_PROVIDER=
# PAYMENT_GATEWAY_PROVIDER=
# PAYMENT_GATEWAY_KEY=
# AI_ASSISTANT_PROVIDER=
